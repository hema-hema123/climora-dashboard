          <a:p>
              <a:pPr marL="280000" indent="-280000"><a:buFont typeface="Arial"/><a:buChar char="•"/></a:pPr>
              <a:r>
                <a:rPr lang="en-US" sz="1350" b="1"><a:solidFill><a:srgbClr val="F8FAFC"/></a:solidFill><a:latin typeface="Segoe UI Semibold"/></a:rPr>
                <a:t>Government Meteorological Ground Stations: </a:t>
              </a:r>
              <a:r>
                <a:rPr lang="en-US" sz="1350"><a:solidFill><a:srgbClr val="CBD5E1"/></a:solidFill><a:latin typeface="Segoe UI"/></a:rPr>
                <a:t>India Meteorological Department (IMD) and NOAA automated surface stations located primarily at airports.</a:t>
              </a:r>
            </a:p>
            <a:p><a:endParaRPr sz="400"/></a:p><a:p>
              <a:pPr marL="280000" indent="-280000"><a:buFont typeface="Arial"/><a:buChar char="•"/></a:pPr>
              <a:r>
                <a:rPr lang="en-US" sz="1350" b="1"><a:solidFill><a:srgbClr val="F8FAFC"/></a:solidFill><a:latin typeface="Segoe UI Semibold"/></a:rPr>
                <a:t>Commercial Desktop GIS Suites: </a:t>
              </a:r>
              <a:r>
                <a:rPr lang="en-US" sz="1350"><a:solidFill><a:srgbClr val="CBD5E1"/></a:solidFill><a:latin typeface="Segoe UI"/></a:rPr>
                <a:t>Heavy desktop software suites including ESRI ArcGIS, ERDAS Imagine, and QGIS requiring manual data handling and desktop installs.</a:t>
              </a:r>
            </a:p>
            <a:p><a:endParaRPr sz="400"/></a:p><a:p>
              <a:pPr marL="280000" indent="-280000"><a:buFont typeface="Arial"/><a:buChar char="•"/></a:pPr>
              <a:r>
                <a:rPr lang="en-US" sz="1350" b="1"><a:solidFill><a:srgbClr val="F8FAFC"/></a:solidFill><a:latin typeface="Segoe UI Semibold"/></a:rPr>
                <a:t>Satellite Data Distribution Portals: </a:t>
              </a:r>
              <a:r>
                <a:rPr lang="en-US" sz="1350"><a:solidFill><a:srgbClr val="CBD5E1"/></a:solidFill><a:latin typeface="Segoe UI"/></a:rPr>
                <a:t>Earth observation portals such as USGS EarthExplorer, NASA Earthdata, and Copernicus Open Access Hub.</a:t>
              </a:r>
            </a:p>
            <a:p><a:endParaRPr sz="400"/></a:p><a:p>
              <a:pPr marL="280000" indent="-280000"><a:buFont typeface="Arial"/><a:buChar char="•"/></a:pPr>
              <a:r>
                <a:rPr lang="en-US" sz="1350" b="1"><a:solidFill><a:srgbClr val="F8FAFC"/></a:solidFill><a:latin typeface="Segoe UI Semibold"/></a:rPr>
                <a:t>Manual Data Wrangling Workflow: </a:t>
              </a:r>
              <a:r>
                <a:rPr lang="en-US" sz="1350"><a:solidFill><a:srgbClr val="CBD5E1"/></a:solidFill><a:latin typeface="Segoe UI"/></a:rPr>
                <a:t>Planners manually download massive GeoTIFF and NetCDF files, requiring extensive desktop preprocessing.</a:t>
              </a:r>
            </a:p>
            <a:p><a:endParaRPr sz="400"/></a:p><a:p>
              <a:pPr marL="280000" indent="-280000"><a:buFont typeface="Arial"/><a:buChar char="•"/></a:pPr>
              <a:r>
                <a:rPr lang="en-US" sz="1350" b="1"><a:solidFill><a:srgbClr val="F8FAFC"/></a:solidFill><a:latin typeface="Segoe UI Semibold"/></a:rPr>
                <a:t>Coarse Weather Applications: </a:t>
              </a:r>

                <a:rPr lang="en-US" sz="1350"><a:solidFill><a:srgbClr val="E2E8F0"/></a:solidFill><a:latin typeface="Segoe UI"/></a:rPr>
                <a:t>Fragmented Learning Tools: Students must switch between separate video players, static PDF notes, and external chatbot tabs.</a:t>
              </a:r>
            </a:p><a:p>
              <a:pPr marL="280000" indent="-280000"><a:buFont typeface="Arial"/><a:buChar char="•"/></a:pPr>
              <a:r>
                <a:rPr lang="en-US" sz="1350"><a:solidFill><a:srgbClr val="E2E8F0"/></a:solidFill><a:latin typeface="Segoe UI"/></a:rPr>
                <a:t>Unscalable Human Tutoring: Professors cannot provide immediate, 24/7 personalized answers to hundreds of individual students.</a:t>
              </a:r>
            </a:p><a:p>
              <a:pPr marL="280000" indent="-280000"><a:buFont typeface="Arial"/><a:buChar char="•"/></a:pPr>
